{
  "name": "bear-accounting",
  "version": "1.0.0",
  "description": "小熊记账 - Windows 离线便携式个人记账工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.xiaoxiong.accounting",
    "productName": "小熊记账",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "index.html", "styles.css", "app.js", "assets/**/*"],
    "portable": { "artifactName": "小熊记账.exe" }
  }
}
